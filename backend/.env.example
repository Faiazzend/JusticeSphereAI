# ContractMind Environment Configuration
PROJECT_NAME=ContractMind
VERSION=1.5.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=contractmind_super_secret_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database & Vector DB
DATABASE_URL=sqlite+aiosqlite:///./contractmind.db
CHROMA_PERSIST_DIR=./chroma_data

# AI Models & Keys
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=deepseek-r1:latest

# Ollama Local Runtime
OLLAMA_BASE_URL=http://localhost:11434

# Directories
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
