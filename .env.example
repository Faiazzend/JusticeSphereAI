# ContractMind v1.5 Environment Variables
# Model Provider API Keys (Optional - Deterministic fallbacks active if unconfigured)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# System Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=contractmind-dev-secret-key-change-in-production

# Storage Directories (Defaults)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
CHROMA_PERSIST_DIR=./data/chromadb
SQLITE_DB_PATH=./data/contractmind.db
